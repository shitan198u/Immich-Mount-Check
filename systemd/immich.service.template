[Unit]
Description=Immich Docker Compose Stack (Auto-mount Managed)
Documentation=https://github.com/shitan198u/Immich-Mount-Check
ConditionPathIsMountPoint=@MOUNT_PATH@
Requires=docker.service
After=docker.service @MOUNT_UNIT@
BindsTo=@MOUNT_UNIT@
PartOf=@MOUNT_UNIT@

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@WORKING_DIR@
ExecStartPre=@SCRIPT_DIR@/immich-precheck.sh
ExecStart=@DOCKER_CMD@ compose up -d --remove-orphans
ExecStop=@SCRIPT_DIR@/immich-stop.sh
ExecStopPost=@SCRIPT_DIR@/immich-stop.sh --post
TimeoutStartSec=300
TimeoutStopSec=60
User=@USER@
Group=docker

[Install]
WantedBy=@MOUNT_UNIT@
