[Unit]
Description=Immich Docker Compose Stack (Auto-mount Managed)
Documentation=https://github.com/shitan198u/Immich-Mount-Check
Requires=docker.service
After=docker.service @MOUNT_UNIT@
BindsTo=@MOUNT_UNIT@
PartOf=@MOUNT_UNIT@

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@WORKING_DIR@
ExecStartPre=@SCRIPT_DIR@/immich-precheck.sh
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=@SCRIPT_DIR@/immich-stop.sh
ExecStopPost=@SCRIPT_DIR@/immich-stop.sh
TimeoutStartSec=180
TimeoutStopSec=30
User=@USER@
Group=docker

[Install]
WantedBy=@MOUNT_UNIT@ multi-user.target
