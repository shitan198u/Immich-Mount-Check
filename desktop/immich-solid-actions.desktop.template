[Desktop Entry]
Type=Service
X-KDE-Solid-Predicate=StorageVolume.usage == 'FileSystem' & StorageAccess.accessible == true
Actions=immichEject;
Name=Safely Eject Immich Drive

[Desktop Action immichEject]
Name=Safely Eject Immich Drive (Stop Stack & Eject)
Icon=media-eject
Exec=@SCRIPT_DIR@/immich-eject.sh --gui
