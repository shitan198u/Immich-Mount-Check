# ##############################################################################
# Mount Check Variables
# ##############################################################################

# The parent directory on the host where your external drive is mounted.
# Example: If mounted at /media/username/my-drive-name, the parent is /media/username
EXTERNAL_MOUNT_PARENT=/media/username

# The folder/label name of your mounted external hard drive.
# Example: If mounted at /media/username/my-drive-name, the name is my-drive-name
EXTERNAL_MOUNT_NAME=my-drive-name

# ##############################################################################
# Immich Core Variables
# ##############################################################################

# The path where your immich library / uploads will be stored.
# If this is on the external drive: /media/username/my-drive-name/immich/upload
# If this is on the OS SSD: /home/username/immich/upload
UPLOAD_LOCATION=/media/username/my-drive-name/immich/upload

# The path where the Postgres database files will be stored.
# If this is on the external drive: /media/username/my-drive-name/immich/postgres
# If this is on the OS SSD: /home/username/immich/postgres
DB_DATA_LOCATION=/home/username/immich/postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The Immich version to use. You can pin this to a specific version like "v3.3.5" or use "v3"
IMMICH_VERSION=v3

# PostgreSQL Database Configuration
DB_PASSWORD=your_secure_db_password_here
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ##############################################################################
# Optional Advanced Safety & Desktop Settings
# ##############################################################################

# (Optional) Filesystem UUID to strictly verify disk identity beyond marker file.
# Run 'findmnt -n -o UUID /path/to/mount' to find your drive's UUID.
# EXPECTED_FS_UUID=faedc8fe-b406-43e6-97fc-0dfaeba457cb

# (Optional) Notification expiration timeout in ms (-1 = follow KDE System Settings default).
NOTIFICATION_TIMEOUT_MS=-1
